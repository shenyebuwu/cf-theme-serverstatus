# Worker reverse-proxy theme: leave API_BASE empty (same-origin API).
# Static hosting: set one or more HTTPS Worker origins, separated by commas.
API_BASE=
TITLE=
BACKGROUND_IMAGE=
BACKGROUND_IMAGE_MOBILE=
CSP_API=
CSP_STATIC=

# Local development only; never embedded in build output.
CFSM_DEV_PROXY=http://127.0.0.1:8787
